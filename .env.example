# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=eduflow
JWT_AUDIENCE=eduflow-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Required by Docker Compose; do not commit real values.
POSTGRES_USER=eduflow
POSTGRES_PASSWORD=
POSTGRES_DB=eduflow
# For native development only. URL-encode special characters in the password.
# Compose constructs this URL from POSTGRES_* using the internal hostname.
DATABASE_URL=postgresql+asyncpg://eduflow:YOUR_URL_ENCODED_PASSWORD@localhost:5432/eduflow
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=104857600
MAX_AUDIO_SECONDS=14400

# Local development defaults to disabled; production Compose forces this on.
RATE_LIMIT_ENABLED=false
AUTH_REQUESTS_PER_MINUTE=10
CHAT_REQUESTS_PER_MINUTE=20
UPLOADS_PER_HOUR=10

# Choose one provider; use a model supported by that provider's account.
AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
AI_TIMEOUT_SECONDS=120
AI_CHUNK_CHARS=12000
AI_MAX_CHUNKS=80
AI_MAX_OUTPUT_TOKENS=6000

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Empty = automatic language detection. Example: ru
WHISPER_LANGUAGE=
# Set to 1 if Hugging Face's Xet downloader stalls; uses regular HTTP downloads.
HF_HUB_DISABLE_XET=0
