# Copy on the SERVER to .env.production, chmod 600, and fill all required values.
# Domain only, without a scheme/path. A/AAAA records must point to this server.
PUBLIC_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
DATA_DIR=/srv/eduflow-data

# Generate distinct random values: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Hex passwords avoid URL-encoding issues when Compose constructs DATABASE_URL.
POSTGRES_USER=eduflow
POSTGRES_PASSWORD=
POSTGRES_DB=eduflow
JWT_SECRET=
JWT_ISSUER=eduflow
JWT_AUDIENCE=eduflow-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

RATE_LIMIT_ENABLED=true
AUTH_REQUESTS_PER_MINUTE=10
CHAT_REQUESTS_PER_MINUTE=20
UPLOADS_PER_HOUR=10
# 100 MiB file limit. Caddy allows 101 MiB for multipart envelope + file.
MAX_UPLOAD_BYTES=104857600
MAX_AUDIO_SECONDS=14400

AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
AI_TIMEOUT_SECONDS=120
AI_CHUNK_CHARS=12000
AI_MAX_CHUNKS=80
AI_MAX_OUTPUT_TOKENS=6000
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
HF_HUB_DISABLE_XET=0
