# Copy to /etc/eduflow/backup.env on the Linux server; chmod 600.
# This is loaded by systemd, not by the application.
EDUFLOW_PROJECT_DIR=/srv/eduflow/app
EDUFLOW_BACKUP_STAGING=/var/lib/eduflow-backup

# Use a bucket/account on a different server/provider from the application.
RESTIC_REPOSITORY=s3:https://S3_ENDPOINT/BUCKET/eduflow
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
